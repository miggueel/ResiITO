
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=resiito
DB_USER=postgres
DB_PASSWORD=CONTRASEÑA_AQUI

JWT_SECRET=GENERAR_CLAVE_PEGARLA_AQUI

# Para generar JWT_SECRET desde CMD:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# URL del frontend (para armar los enlaces que se envían por correo)
FRONTEND_URL=http://localhost:5173

# Correo saliente (SMTP). Si SMTP_HOST está vacío, los correos se
# muestran en la consola del backend (útil en desarrollo).
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una
# "contraseña de aplicación" de la cuenta en SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ResiITO <residencias@itoaxaca.edu.mx>"
